<Window x:Class="BackupFolderFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BackupFolderFinder.ViewModels"
        xmlns:converters="clr-namespace:BackupFolderFinder.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="app.ico"
        Height="780" Width="1200"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:StatusToBrushConverter x:Key="StatusBrushConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header & Search Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Stat Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Master & Detail Grids -->
            <RowDefinition Height="*"/>
            <!-- Action Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP CARD: Header & Folder Selection -->
        <Border Grid.Row="0" Margin="16,16,16,8" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Title Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Subtitle with Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="#EFF6FF" CornerRadius="6" Width="38" Height="38" Margin="0,0,12,0" Padding="4"
                                BorderBrush="#DBEAFE" BorderThickness="1">
                            <Image Source="app.ico" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Backup Folder Finder" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BuildNumber}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Scan and clean redundant daily project backups while safeguarding earliest and protected copies"
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Subtle M13 Branding (Top Right) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,2" ToolTip="Created by M13">
                            <TextBlock Text="M13" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Folder Input Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Backup Directory:" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="13" Margin="0,0,12,0"/>

                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}"
                             Text="{Binding RootFolder, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                             Margin="0,0,10,0" VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2" Style="{StaticResource ModernButton}" Content="Browse..."
                            Command="{Binding BrowseFolderCommand}"
                            Margin="0,0,10,0"/>

                    <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="🔍  Scan"
                            Command="{Binding ScanCommand}"
                            Margin="0,0,10,0"/>

                    <Button Grid.Column="4" Style="{StaticResource ModernButton}" Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                </Grid>

                <!-- Progress Bar when busy -->
                <ProgressBar Grid.Row="2" Height="3" IsIndeterminate="True" Margin="0,10,0,0"
                             BorderThickness="0" Background="#E2E8F0" Foreground="{StaticResource PrimaryBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
            </Grid>
        </Border>

        <!-- STATS CARDS (Visible when scan has results) -->
        <Grid Grid.Row="1" Margin="16,0,16,8"
              Visibility="{Binding DaysRequiringCleanup, Converter={StaticResource CountToVisConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Days to Clean -->
            <Border Grid.Column="0" Margin="0,0,8,0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#FEF3C7" CornerRadius="5" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="📅" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DaysRequiringCleanup, StringFormat='{}{0} Days'}"
                                   FontSize="16" FontWeight="Bold" Foreground="#92400E"/>
                        <TextBlock Text="Requiring cleanup action" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Backups to Delete -->
            <Border Grid.Column="1" Margin="4,0,4,0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#FEE2E2" CornerRadius="5" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="🗑️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCandidateDeletes, StringFormat='{}{0} Redundant'}"
                                   FontSize="16" FontWeight="Bold" Foreground="#B91C1C"/>
                        <TextBlock Text="Candidate backup folders to delete" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: Protected Backups -->
            <Border Grid.Column="2" Margin="8,0,0,0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#DBEAFE" CornerRadius="5" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="🛡️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalProtectedBackups, StringFormat='{}{0} Protected'}"
                                   FontSize="16" FontWeight="Bold" Foreground="#1E40AF"/>
                        <TextBlock Text="Backups preserved by safety rules" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MASTER - DETAIL VIEW WITH SPLITTER -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.RowDefinitions>
                <!-- Master: Retention Groups -->
                <RowDefinition Height="3*" MinHeight="150"/>
                <!-- Splitter -->
                <RowDefinition Height="8"/>
                <!-- Detail: Backups for Selected Group -->
                <RowDefinition Height="2*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <!-- MASTER PANEL: Retention Groups -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="14,10" CornerRadius="6,6,0,0">
                        <Grid>
                            <TextBlock Text="Retention Analysis (Days with Multiple Backups)" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding RetentionGroups.Count, StringFormat='{}{0} group(s)'}"/>
                        </Grid>
                    </Border>

                    <!-- Retention Groups Grid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RetentionGroups}"
                              SelectedItem="{Binding SelectedGroup}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="150"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding BackupDateFormatted}" Width="120"/>
                            <DataGridTemplateColumn Header="Keep (Earliest)" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#E6F4EA" BorderBrush="#B4E1C3" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding KeepTime}" Foreground="#137333" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Delete Candidates" Binding="{Binding DeleteTimes}" Width="2*"/>
                            <DataGridTemplateColumn Header="Delete Count" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#FCE8E6" BorderBrush="#F5C3C0" BorderThickness="1"
                                                CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding DeleteCount}" Foreground="#C5221F" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Protected Backups" Binding="{Binding ProtectedTimes}" Width="1.5*"/>
                            <DataGridTemplateColumn Header="Protected Count" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#E8F0FE" BorderBrush="#C3DAFE" BorderThickness="1"
                                                CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ProtectedCount}" Foreground="#1A73E8" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent" ShowsPreview="True" Cursor="SizeNS"/>

            <!-- DETAIL PANEL: Backups in Selected Group -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="14,10" CornerRadius="6,6,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Backups for Selected Day" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                                <TextBlock Text="{Binding SelectedGroup.ProjectName, StringFormat='{} — Project: {0}'}"
                                           FontWeight="Normal" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding SelectedGroup, Converter={StaticResource NullToVisConverter}}"/>
                                <TextBlock Text="{Binding SelectedGroup.BackupDateFormatted, StringFormat='{} ({0})'}"
                                           FontWeight="Normal" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding SelectedGroup, Converter={StaticResource NullToVisConverter}}"/>
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding DisplayBackups.Count, StringFormat='{}{0} folder(s)'}"/>
                        </Grid>
                    </Border>

                    <!-- Backups Detail Grid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DisplayBackups}"
                              SelectedItem="{Binding SelectedBackup}"
                              MouseDoubleClick="DetailDataGrid_MouseDoubleClick"
                              BorderThickness="0">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open Folder in File Explorer" Command="{Binding OpenFolderCommand}"/>
                                <MenuItem Header="Copy Full Path" Command="{Binding CopyPathCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100"/>
                            <!-- Status with Color Badge Pill -->
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusBrushConverter}, ConverterParameter=Background}"
                                                BorderBrush="{Binding Status, Converter={StaticResource StatusBrushConverter}, ConverterParameter=Border}"
                                                BorderThickness="1"
                                                CornerRadius="10" Padding="10,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}, ConverterParameter=Foreground}"
                                                       FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Folder Name" Binding="{Binding FolderName}" Width="180"/>
                            <DataGridTextColumn Header="Full Directory Path" Binding="{Binding TimeFolder}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ACTION BAR -->
        <Border Grid.Row="3" Margin="16,0,16,10" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Open Folder Button -->
                <Button Grid.Column="0" Style="{StaticResource ModernButton}" Content="📂  Open in Explorer"
                        Command="{Binding OpenFolderCommand}"
                        ToolTip="Open the selected backup folder in Windows File Explorer (or double-click row)"/>

                <!-- Right Action Buttons -->
                <Button Grid.Column="2" Style="{StaticResource DangerButton}" Content="🗑️  Delete Selected Day"
                        Command="{Binding DeleteSelectedCommand}"
                        Margin="0,0,10,0"
                        ToolTip="Permanently delete candidate backups for the currently selected day"/>

                <Button Grid.Column="3" Style="{StaticResource DangerButton}" Content="⚠️  Delete All Candidate Backups"
                        Command="{Binding DeleteAllCommand}"
                        Background="#991B1B"
                        ToolTip="Permanently delete all candidate redundant backups across all days"/>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="4" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️ " FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>

            <!-- Subtle Build Number and M13 Tag (Bottom Right) -->
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                    <TextBlock Text="{Binding BuildNumber}" FontSize="11" Foreground="#94A3B8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="•" FontSize="11" Foreground="#CBD5E1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AuthorTag}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" ToolTip="M13"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
